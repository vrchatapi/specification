{
	"name": "vrchat-openapi",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"description": "VRChat API OpenAPI Specification",
	"license": "MIT",
	"scripts": {
		"bundle": "redocly bundle",
		"lint": "pnpm --no-bail --stream --reporter-hide-prefix --color run '/^lint:/'",
		"lint-ci": "pnpm --stream --reporter-hide-prefix run '/^lint:/'",
		"lint:spectral": "bun spectral openapi/openapi.yaml",
		"lint:eslint": "eslint . ${CI:+-f @jamesacarr/eslint-formatter-github-actions}",
		"lint:arazzo": "redocly lint test/arazzo.yaml",
		"test": "sh test/run.sh",
		"test:coverage": "redocly coverage test/.out/har --api dist/openapi-internal.json",
		"test:drift": "redocly drift test/.out/har --api dist/openapi-test.yaml"
	},
	"devDependencies": {
		"@actions/core": "^1.11.1",
		"@ariesclark/eslint-config": "^3.1.1",
		"@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
		"@redocly/cli": "link:../redocly-cli/packages/cli",
		"@redocly/openapi-core": "^2.41.2",
		"@stoplight/spectral-core": "^1.20.0",
		"@stoplight/spectral-formats": "^1.8.2",
		"@stoplight/spectral-formatters": "^1.5.0",
		"@stoplight/spectral-parsers": "^1.0.5",
		"@stoplight/spectral-rulesets": "^1.22.0",
		"@types/bun": "^1.3.3",
		"@types/node": "^24.10.1",
		"@types/pluralize": "^0.0.33",
		"change-case": "^5.4.4",
		"cspell-lib": "^9.3.2",
		"eslint": "^9.39.1",
		"httpexec": "^0.0.2",
		"pluralize": "^8.0.0",
		"semver": "^7.7.3",
		"totp-generator": "^2.0.1",
		"typescript": "^6.0.3"
	}
}
