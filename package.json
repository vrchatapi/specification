{
	"name": "vrchat-openapi",
	"type": "module",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@11.20.0",
	"description": "VRChat API OpenAPI Specification",
	"author": "",
	"license": "MIT",
	"main": "index.js",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint-openapi": "redocly lint openapi/openapi.yaml --max-problems 1000",
		"lint-openapi-ci": "pnpm -s run lint-openapi --format github-actions",
		"lint-eslint": "eslint .",
		"lint-eslint-ci": "pnpm -s run lint-eslint -f @jamesacarr/eslint-formatter-github-actions",
		"lint-arazzo": "redocly lint test/arazzo.yaml",
		"lint-arazzo-ci": "pnpm -s run lint-arazzo",
		"lint": "pnpm --no-bail --stream --reporter-hide-prefix --color run '/^lint-(?!ci$)(?!.*-ci$).*/'",
		"lint-ci": "pnpm --stream --reporter-hide-prefix run '/^lint-.*-ci$/'",
		"bundle": "redocly bundle",
		"test": "sh test/run.sh",
		"test:coverage": "redocly coverage test/.out/har --api dist/openapi-internal.json",
		"test:drift": "redocly drift test/.out/har --api dist/openapi-test.yaml --server https://api.vrchat.cloud/api/1 --rules schema-consistency,undocumented-endpoint",
		"test:legacy": "redocly lint dist/openapi-legacy.json dist/openapi-internal+legacy.json --extends minimal",
		"test:downlevel": "pnpm --filter redocly-plugin-downlevel run test && pnpm --filter redocly-plugin-downlevel run build"
	},
	"devDependencies": {
		"@actions/artifact": "5.0.2",
		"@actions/core": "^1.11.1",
		"@apidevtools/json-schema-ref-parser": "^15.5.2",
		"@ariesclark/eslint-config": "^3.1.1",
		"@cspell/eslint-plugin": "^10.3.3",
		"@eslint-react/eslint-plugin": "^2.13.0",
		"@jamesacarr/eslint-formatter-github-actions": "^0.2.0",
		"@redocly/cli": "^2.53.3",
		"@redocly/openapi-core": "^2.53.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^24.13.6",
		"@types/pluralize": "^0.0.33",
		"change-case": "^5.4.4",
		"cspell": "^9.8.0",
		"eslint": "^9.39.5",
		"httpexec": "^0.0.2",
		"pluralize": "^8.0.0",
		"semver": "^7.8.5",
		"totp-generator": "^2.0.1",
		"typescript": "^6.0.3"
	}
}
