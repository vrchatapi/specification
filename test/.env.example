# Credentials for the conformance suite. Copy to `test/.env` and fill in.
# `.env` is gitignored; this example is not.

# Login, used by the `login` workflow in `pnpm test` to mint a session. That
# step also derives the account's id and display name, so neither is set here.
VRCHAT_EMAIL=
VRCHAT_PASSWORD=
VRCHAT_TOTP_SECRET=

# Optional: only needed when the account's login name differs from its email.
VRCHAT_USERNAME=

# Another account to exercise the friend and group-invite workflows against.
# Must not be the account above.
VRCHAT_FRIEND_ID=usr_00000000-0000-0000-0000-000000000000
