exports[`fixtures oai/3.2/link-object-examples.yaml 1`] = `
{
  "3.0.0": "as 3.0.1",
  "3.0.1": "as 3.0.2",
  "3.0.2": "as 3.0.3",
  "3.0.3": "as 3.0.4",
  "3.0.4": "as 3.1.0",
  "3.1.0": "as 3.1.1",
  "3.1.1": "as 3.1.2",
  "3.1.2": {
    "document": {
      "components": {},
      "info": {
        "title": "API",
        "version": "1.0.0",
      },
      "openapi": "3.1.2",
      "paths": {
        "/users/{id}": {
          "get": {
            "responses": {
              "200": {
                "content": {
                  "application/json": {
                    "schema": {
                      "properties": {
                        "uuid": {
                          "format": "uuid",
                          "type": "string",
                        },
                      },
                      "type": "object",
                    },
                  },
                },
                "description": "the user being returned",
                "links": {
                  "UserRepositories": {
                    "operationRef": "#/paths/~12.0~1repositories~1%7Busername%7D/get",
                    "parameters": {
                      "username": "$response.body#/username",
                    },
                  },
                  "UserRepositories2": {
                    "operationRef": "https://na2.gigantic-server.com/#/paths/~12.0~1repositories~1%7Busername%7D/get",
                    "parameters": {
                      "username": "$response.body#/username",
                    },
                  },
                  "address": {
                    "operationId": "getUserAddress",
                    "parameters": {
                      "userid": "$request.path.id",
                    },
                  },
                  "address2": {
                    "operationId": "getUserAddressByUUID",
                    "parameters": {
                      "userUuid": "$response.body#/uuid",
                    },
                  },
                  "withBody": {
                    "operationId": "queryUserWithBody",
                    "requestBody": {
                      "userId": "$request.path.id",
                    },
                  },
                },
              },
            },
          },
          "parameters": [
            {
              "description": "the user identifier, as userId",
              "in": "path",
              "name": "id",
              "required": true,
              "schema": {
                "type": "string",
              },
            },
          ],
        },
        "/users/{userid}/address": {
          "get": {
            "operationId": "getUserAddress",
            "responses": {
              "200": {
                "description": "the user's address",
              },
            },
          },
          "parameters": [
            {
              "description": "the user identifier, as userId",
              "in": "path",
              "name": "userid",
              "required": true,
              "schema": {
                "type": "string",
              },
            },
          ],
        },
      },
    },
    "loosened": "unchanged",
    "problems": [],
  },
}
`;

