{
	"name": "redocly-plugin-downlevel",
	"type": "module",
	"version": "0.1.0",
	"description": "Redocly plugin that rewrites an OpenAPI 3.x description as an earlier 3.x release, one release at a time.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vrchatapi/specification.git",
		"directory": "packages/redocly-plugin-downlevel"
	},
	"keywords": [
		"redocly",
		"redocly-plugin",
		"openapi",
		"openapi-3.2",
		"openapi-3.1",
		"openapi-3.0",
		"downlevel",
		"convert"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "bun test",
		"prepack": "pnpm run build"
	},
	"peerDependencies": {
		"@redocly/openapi-core": "^2.53.3"
	},
	"devDependencies": {
		"@redocly/openapi-core": "^2.53.3",
		"@types/bun": "^1.4.2",
		"@types/node": "^24.13.6",
		"typescript": "^6.0.3"
	}
}
